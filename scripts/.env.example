# pgBrain release credentials. Copy to scripts/.env and fill in.
# Never commit the real .env (it's already gitignored).

# Apple Developer team ID (10-character alphanumeric).
TEAM_ID=

# Full codesigning identity name. Find with:
#   security find-identity -v -p codesigning
CODESIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# notarytool keychain profile name. Create once with:
#   xcrun notarytool store-credentials "pgBrain" \
#       --apple-id <email> --team-id <TEAM_ID> --password <app-specific-password>
NOTARYTOOL_PROFILE="pgBrain"

# GitHub repo (owner/repo). DMGs are uploaded as release assets; appcast.xml
# is served from the default branch via raw.githubusercontent.com.
GITHUB_REPO="souriscloud/pgbrain"
